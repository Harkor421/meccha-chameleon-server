# Copy to .env for local overrides. Real environment variables always win.

# --- network ---
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info               # debug | info | warn | error
# ALLOW_ORIGINS=https://yourgame.com,https://www.yourgame.com   # empty = allow all

# --- rooms / capacity ---
MAX_PLAYERS_PER_ROOM=16
MAX_ROOMS=200
ROOM_EMPTY_GRACE_MS=30000

# --- presence ---
TICK_HZ=20
HEARTBEAT_MS=30000
MAX_WS_BUFFERED=1048576       # drop voice to a client whose send buffer exceeds this

# --- round timing (ms) ---
PHASE_PREP_MS=30000
PHASE_HUNT_MS=90000
PHASE_RESULTS_MS=8000
MC_TIME_SCALE=1              # <1 speeds rounds up (e.g. 0.1 for tests/demos)
SEEKER_PER=4                 # ~1 seeker per N players
TAG_RADIUS=2.8
ARENA_BOUND=80

# --- anti-abuse ---
MSG_MAX_PER_SEC=80
PAINT_MAX_PER_SEC=4
PAINT_MAX_LEN=120000

# --- voice relay ---
VOICE_MAX_PER_SEC=70
VOICE_MAX_SPEAKERS=16
VOICE_ACTIVE_WINDOW_MS=500
